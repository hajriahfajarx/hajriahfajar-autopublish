# Copy this to .env and fill in, or just run `npm run setup` and let the local
# settings UI fill this in for you (recommended).

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Comma-separated list, tried in order with its own retry cycle each before
# falling through to the next. "gemini-flash-latest" is an alias that always
# points to Google's current best free-tier Flash model, so it keeps working
# even after Google retires a specific version (e.g. the Gemini 2.5 line is
# being shut down Oct 16, 2026). The Flash-Lite fallback is there because the
# primary model can get temporarily overloaded (503) under high demand.
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# --- Google OAuth (Blogger + Sheets) ---
# From a Desktop-app OAuth Client ID in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained once via `npm run setup` (OAuth consent flow) — long-lived, do not share.
GOOGLE_REFRESH_TOKEN=

# --- Blogger ---
# Auto-detected by `npm run setup` via blogs.getByUrl, or find it manually in
# your Blogger dashboard URL (https://www.blogger.com/blog/posts/<BLOG_ID>).
BLOG_ID=

# --- Google Sheets (dedup log) ---
# Auto-created by `npm run setup` if left blank, or paste an existing Sheet ID.
SHEET_ID=

# --- Scheduling (used by src/run.mjs's random-delay step) ---
PUBLISH_WINDOW_START=19:00
PUBLISH_WINDOW_END=20:30
PUBLISH_TIMEZONE=Asia/Jakarta

# --- Categories included in the automated rotation (comma-separated slugs) ---
# Fragment Hidup is intentionally excluded by default — see README.
ACTIVE_CATEGORIES=digital-insights,faith-society,productivity,performance-mindset
